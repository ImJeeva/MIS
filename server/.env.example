PORT=4000
JWT_SECRET="dev-only-change-me-in-production-8f2a9c1e"
JWT_EXPIRES_IN="7d"

UPLOAD_DIR="uploads"
MAX_UPLOAD_MB=15

AI_SERVICE_URL="http://localhost:8000"
AI_TIMEOUT_MS=45000

CLIENT_ORIGIN="http://localhost:5173"
